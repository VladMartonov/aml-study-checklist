{
  "name": "aml-study-checklist",
  "version": "1.0.0",
  "private": true,
  "description": "Shared study checklist for AML Certification Centre learners.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.29",
    "prisma": "6.19.3",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
